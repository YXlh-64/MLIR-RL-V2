# Conda prefix (train.sh and eval.sh accept an environment directory).
CONDA_ENV=/home/YOUR_NETID/.conda/envs/mlir
LLVM_BUILD_PATH=/scratch/YOUR_NETID/Code/MLIR-RL-V2/llvm-project/build
MLIR_SHARED_LIBS=${LLVM_BUILD_PATH}/lib/libomp.so,${LLVM_BUILD_PATH}/lib/libmlir_c_runner_utils.so,${LLVM_BUILD_PATH}/lib/libmlir_runner_utils.so
AST_DUMPER_BIN_PATH=/scratch/YOUR_NETID/Code/MLIR-RL-V2/tools/ast_dumper/build/bin/AstDumper
PRE_VEC_BIN_PATH=/scratch/YOUR_NETID/Code/MLIR-RL-V2/tools/pre_vec/build/bin/PreVec
VECTORIZER_BIN_PATH=/scratch/YOUR_NETID/Code/MLIR-RL-V2/tools/vectorizer/build/bin/Vectorizer
PATH=${LLVM_BUILD_PATH}/bin:${PATH}
PYTHONPATH=${LLVM_BUILD_PATH}/tools/mlir/python_packages/mlir_core${PYTHONPATH:+:${PYTHONPATH}}
LD_LIBRARY_PATH=${LLVM_BUILD_PATH}/lib:${CONDA_ENV}/lib${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}
