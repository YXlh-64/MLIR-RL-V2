# Local machine configuration and Python environments
.env
.env.*
!.env.example
.venv/
venv/
.conda/
.vscode/

# Copied LLVM sources, compiler outputs, and native helper builds
/llvm-project/
/build/
/tools/*/build*/
CMakeFiles/
CMakeCache.txt
compile_commands.json

# Generated data, experiment outputs, caches, and model weights
/data/**
!/data/.gitignore
/results/**
!/results/.gitignore
/logs/**
!/logs/.gitignore
/dask-logs/**
!/dask-logs/.gitignore
__pycache__/
*.py[cod]
.pytest_cache/
.cache/
*.pt
*.pth
*.onnx
*.o
*.a
*.so
*.so.*

# Model checkpoints (symlink to scratch storage) and other weight formats
/checkpoints
checkpoints/
*.ckpt
*.safetensors
*.h5
*.bin

# Logs, Slurm outputs, arrays and pickles
*.log
*.out
*.err
slurm-*.out
*.npy
*.npz
*.pkl
*.pickle
*.parquet
wandb/

# Raw experiment outputs (hundreds of MB, tens of thousands of files); code and reports stay tracked
/experiments/*/results/
/experiments/**/__pycache__/
